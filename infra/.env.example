# ─────────────────────────────────────────────────────────────────────────────
# LinkMe — variables d'environnement (copier en .env ; ne JAMAIS committer .env)
# ─────────────────────────────────────────────────────────────────────────────

# Domaine public servi par Caddy (HTTPS automatique Let's Encrypt). "localhost" = certificat local.
SITE_DOMAIN=localhost
# URL publique complète (liens de partage, Open Graph, emails, retours de paiement)
PUBLIC_BASE_URL=https://localhost
# Email de contact Let's Encrypt (production)
ACME_EMAIL=admin@example.com

# ── Base de données ─────────────────────────────────────────────────────────
POSTGRES_DB=linkme
POSTGRES_USER=linkme
# Générer : openssl rand -base64 32
POSTGRES_PASSWORD=change-me-postgres

# ── API (Spring Boot) ──────────────────────────────────────────────────────
# Profil : prod | dev (dev = seed de démo /malick + paiements Mock + uploads locaux)
SPRING_PROFILES_ACTIVE=dev
# Seed de démonstration (/malick) — true en dev, false en production
SEED_DEMO=true
# Commission plateforme en % (D5)
PLATFORM_COMMISSION_PERCENT=8
# Cookie de session sécurisé (true derrière HTTPS)
SESSION_COOKIE_SECURE=true

# ── Cloudinary (D8) — laisser vide pour utiliser les uploads locaux en dev ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uploads locaux (volume media) si Cloudinary n'est pas configuré
LOCAL_UPLOADS_ENABLED=true

# ── Paiements (D9) — un adaptateur n'est activé que si ses clés sont présentes
# Fournisseur par défaut au checkout : mock | paydunya | cinetpay
PAYMENT_DEFAULT_PROVIDER=mock
# Mock (dev/tests uniquement) — secret HMAC des webhooks simulés
PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_WEBHOOK_SECRET=change-me-mock-secret
# PayDunya — https://developers.paydunya.com
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
# CinetPay — https://docs.cinetpay.com
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# ── Emails (SMTP) — vides = emails écrits dans les logs (dev) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=LinkMe <no-reply@example.com>

# ── Front SSR ──────────────────────────────────────────────────────────────
# Hôtes acceptés par le SSR (protection SSRF d'Angular)
ALLOWED_HOSTS=localhost,web
